#VRML_SIM R2025a utf8
WorldInfo { basicTimeStep 16 }
Viewpoint { orientation 0.18 0.98 0.05 3.2 position 0.9 0.65 0.75 }
TexturedBackground { }
TexturedBackgroundLight { }
Floor { size 4 4 }
Solid {
  translation 0.55 0 0.035
  children [ Shape { geometry Box { size 0.08 0.08 0.07 } appearance PBRAppearance { baseColor 0.9 0.25 0.25 roughness 0.6 } } ]
  name "red_toy"
  boundingObject Box { size 0.08 0.08 0.07 }
  physics Physics { mass 0.08 }
}
Solid {
  translation 0.3 0.35 0.12
  children [ Shape { geometry Box { size 0.18 0.18 0.24 } appearance PBRAppearance { baseColor 0.25 0.35 0.7 roughness 0.8 } } ]
  boundingObject Box { size 0.18 0.18 0.24 }
  name "obstacle"
}
Robot {
  translation 0 0 0.04
  name "alien"
  controller "alien_gait"
  children [
    Shape { geometry Capsule { radius 0.07 height 0.16 } appearance PBRAppearance { baseColor 0.45 0.8 0.55 roughness 0.65 } }
    Transform { translation 0 0 0.17 children [ Shape { geometry Sphere { radius 0.085 } appearance PBRAppearance { baseColor 0.5 0.85 0.6 roughness 0.55 } } ] }
    Transform { translation 0 -0.052 0.185 children [ Camera { name "left_eye" width 320 height 240 fieldOfView 1.1 } ] }
    Transform { translation 0 0.052 0.185 children [ Camera { name "right_eye" width 320 height 240 fieldOfView 1.1 } ] }
    Transform { translation 0 -0.045 0.11 children [ Shape { geometry Box { size 0.035 0.025 0.025 } appearance PBRAppearance { baseColor 0.08 0.08 0.08 } } ] }
    Transform { translation 0 0.045 0.11 children [ Shape { geometry Box { size 0.035 0.025 0.025 } appearance PBRAppearance { baseColor 0.08 0.08 0.08 } } ] }

    HingeJoint {
      jointParameters HingeJointParameters { axis 1 0 0 anchor -0.045 -0.055 0.04 }
      device [
        RotationalMotor { name "left_hip_motor" maxVelocity 6 maxTorque 0.65 }
        PositionSensor { name "left_hip_sensor" }
      ]
      endPoint Solid {
        translation 0 -0.055 -0.015
        children [
          Shape { geometry Capsule { radius 0.028 height 0.08 } appearance PBRAppearance { baseColor 0.45 0.8 0.55 } }
          HingeJoint {
            jointParameters HingeJointParameters { axis 1 0 0 anchor 0 0 -0.06 }
            device [
              RotationalMotor { name "left_knee_motor" maxVelocity 7 maxTorque 0.55 }
              PositionSensor { name "left_knee_sensor" }
            ]
            endPoint Solid {
              translation 0 0 -0.12
              children [
                Shape { geometry Capsule { radius 0.024 height 0.08 } appearance PBRAppearance { baseColor 0.45 0.8 0.55 } }
                HingeJoint {
                  jointParameters HingeJointParameters { axis 1 0 0 anchor 0 0 -0.06 }
                  device [
                    RotationalMotor { name "left_ankle_motor" maxVelocity 7 maxTorque 0.35 }
                    PositionSensor { name "left_ankle_sensor" }
                  ]
                  endPoint Solid {
                    translation 0 0 -0.11
                    children [ Shape { geometry Box { size 0.07 0.11 0.025 } appearance PBRAppearance { baseColor 0.25 0.25 0.3 } } ]
                    name "left_foot"
                    boundingObject Box { size 0.07 0.11 0.025 }
                    physics Physics { mass 0.04 }
                  }
                }
              ]
              name "left_shin"
              boundingObject Capsule { radius 0.024 height 0.08 }
              physics Physics { mass 0.045 }
            }
          }
        ]
        name "left_thigh"
        boundingObject Capsule { radius 0.028 height 0.08 }
        physics Physics { mass 0.055 }
      }
    }

    HingeJoint {
      jointParameters HingeJointParameters { axis 1 0 0 anchor -0.045 0.055 0.04 }
      device [
        RotationalMotor { name "right_hip_motor" maxVelocity 6 maxTorque 0.65 }
        PositionSensor { name "right_hip_sensor" }
      ]
      endPoint Solid {
        translation 0 0.055 -0.015
        children [
          Shape { geometry Capsule { radius 0.028 height 0.08 } appearance PBRAppearance { baseColor 0.45 0.8 0.55 } }
          HingeJoint {
            jointParameters HingeJointParameters { axis 1 0 0 anchor 0 0 -0.06 }
            device [
              RotationalMotor { name "right_knee_motor" maxVelocity 7 maxTorque 0.55 }
              PositionSensor { name "right_knee_sensor" }
            ]
            endPoint Solid {
              translation 0 0 -0.12
              children [
                Shape { geometry Capsule { radius 0.024 height 0.08 } appearance PBRAppearance { baseColor 0.45 0.8 0.55 } }
                HingeJoint {
                  jointParameters HingeJointParameters { axis 1 0 0 anchor 0 0 -0.06 }
                  device [
                    RotationalMotor { name "right_ankle_motor" maxVelocity 7 maxTorque 0.35 }
                    PositionSensor { name "right_ankle_sensor" }
                  ]
                  endPoint Solid {
                    translation 0 0 -0.11
                    children [ Shape { geometry Box { size 0.07 0.11 0.025 } appearance PBRAppearance { baseColor 0.25 0.25 0.3 } } ]
                    name "right_foot"
                    boundingObject Box { size 0.07 0.11 0.025 }
                    physics Physics { mass 0.04 }
                  }
                }
              ]
              name "right_shin"
              boundingObject Capsule { radius 0.024 height 0.08 }
              physics Physics { mass 0.045 }
            }
          }
        ]
        name "right_thigh"
        boundingObject Capsule { radius 0.028 height 0.08 }
        physics Physics { mass 0.055 }
      }
    }

    TouchSensor { name "left_foot_contact" type "bumper" }
    TouchSensor { name "right_foot_contact" type "bumper" }
    Accelerometer { name "imu_accelerometer" }
    Gyro { name "imu_gyro" }
    InertialUnit { name "imu" }
    DistanceSensor { name "front_range" lookupTable [ 0 0 0 2 2 0 ] }
    Microphone { name "microphone" }
    Speaker { name "speaker" }
  ]
}
